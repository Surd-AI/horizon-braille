{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "packages/core/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/playground/src/**/*.ts"
  ]
}
